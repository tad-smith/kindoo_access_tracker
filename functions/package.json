{
  "name": "@kindoo/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "deps:check": "node scripts/check-deploy-deps.mjs",
    "deps:relock": "node scripts/relock-deploy-deps.mjs",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "shell": "firebase functions:shell",
    "test": "vitest run",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/",
    "test:integration:local": "firebase emulators:exec --only firestore,auth --project demo-kindoo-tests 'pnpm exec vitest run tests/'",
    "lint": "prettier --check src tests",
    "typecheck": "tsc -b tsconfig.tests.json"
  },
  "dependencies": {
    "@firebase/app": "^0.14.13",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "@kindoo/shared": "workspace:*",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "firebase-functions-test": "^3.5.0",
    "vitest": "^4.1.11"
  }
}
