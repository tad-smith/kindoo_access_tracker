rules_version = '2';

// Firestore Security Rules — full per-collection allow/deny matrix per
// `docs/firebase-schema.md` §6.
//
// Conventions:
//
//   - Helpers at top: `isAuthed`, `authedCanonical`, `isManager`,
//     `isStakeMember`, `bishopricWardOf`, `isAnyMember`,
//     `isPlatformSuperadmin`, `lastActorMatchesAuth`. Defined once,
//     reused throughout.
//
//   - `lastActor` integrity check is the primary defense: every
//     client write must carry `lastActor.{email, canonical}` matching
//     the auth token's typed email + custom-claim canonical. This is
//     what gives the audit trigger a trustworthy `actor_email`.
//
//   - `getAfter()` is used in exactly one place — `seats.create`'s
//     `tiedToRequestCompletion` invariant — so a seat creation
//     proves it is the resolution of a pending request transitioning
//     to `complete` in the same write.
//
//   - Split-ownership on `access`: `importer_callings` is
//     server-only (Importer via Admin SDK bypasses rules). Manager
//     updates must leave it byte-equal to the prior value. Manual
//     side (`manual_grants`) is the manager's lane.
//
//   - Cross-stake denial is automatic: `isAnyMember(stakeId)` returns
//     false when the user has no claim block for `stakeId`, so a
//     read against another stake fails the parent-doc rule and never
//     reaches the subcollection rules.
//
//   - Admin SDK writes (claim sync, audit trigger, remove-seat trigger,
//     Sync fix applier) bypass rules entirely. The Cloud Functions code
//     carries the discipline.
//
//   - Bootstrap-wizard escape hatch: `isBootstrapAdmin(stakeId)` lets
//     the designated `stake.bootstrap_admin_email` user write to the
//     wizard-managed collections (stakes/{sid}, kindooManagers, wards,
//     buildings) WHILE `setup_complete == false`. Once the wizard
//     flips that flag to true, the gate goes silent — by then the
//     `syncManagersClaims` trigger has minted the bootstrap admin a
//     real manager claim from their auto-added kindooManagers doc, so
//     `isManager(stakeId)` takes over. This breaks the chicken-and-egg
//     where the very first wizard write (the bootstrap admin's own
//     kindooManagers doc) had nothing else to authorise it.
//
//     Operator pre-step: the stake doc must exist with
//     `setup_complete=false` and
//     `bootstrap_admin_email=<lowercased email; dots and +suffix preserved>`
//     BEFORE the bootstrap admin signs in for the first time. The
//     `createStake` callable applies `.trim().toLowerCase()`; manual
//     Firestore-console seeds must apply the same transform. The rule
//     does a case-sensitive string compare against
//     `request.auth.token.email`, which Google OAuth delivers
//     lowercased — so the stored value must be lowercased on both
//     sides. NOT `canonicalEmail()` — that would strip Gmail dots
//     and `+suffix`, breaking the escape hatch for any operator who
//     uses those address variants (see `firebase-schema.md` §4.1
//     "Bootstrap-admin email normalization"). See
//     `infra/runbooks/provision-firebase-projects.md` for the seed
//     instructions.
//
//   - Setup-in-progress read gate: `isSetupInProgressReadable(stakeId)`
//     lets ANY authed user read the parent stake doc while
//     `setup_complete == false`. Required by the SPA's setup-complete
//     gate (per `docs/spec.md` §10): a non-admin signing in during bootstrap
//     must land on SetupInProgress (not NotAuthorized), and the gate
//     can only know "we're in setup" by reading the parent doc.
//     Once the wizard completes, this gate goes silent and standard
//     `isAnyMember` membership reads take over.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====

    function isAuthed() {
      return request.auth != null;
    }

    // Trustworthy: `canonical` is set by the sync triggers as a custom
    // claim (`syncManagersClaims` / `syncAccessClaims` /
    // `syncSuperadminClaims`). Comparing against this lets us key off
    // the canonical email without a per-call userIndex lookup.
    function authedCanonical() {
      return request.auth.token.canonical;
    }

    function isManager(stakeId) {
      return isAuthed()
        && 'stakes' in request.auth.token
        && stakeId in request.auth.token.stakes
        && request.auth.token.stakes[stakeId].manager == true;
    }

    function isStakeMember(stakeId) {
      return isAuthed()
        && 'stakes' in request.auth.token
        && stakeId in request.auth.token.stakes
        && request.auth.token.stakes[stakeId].stake == true;
    }

    // Limited app access (D25). An opt-in per-stake flag minted onto
    // the stake claim block alongside `manager` / `stake` / `wards`.
    // Absent (the overwhelmingly common case) means FULL access and
    // nothing about the user's write surface changes. When true, the
    // `requests` create predicate narrows to the temp / remove subset
    // — see the D25 clause at the end of that rule.
    //
    // The `'limited' in ...` presence guard matters: the claim minter
    // omits the key entirely for full users rather than writing
    // `limited: false`, so a bare field read would error on every
    // full user's write.
    function isLimited(stakeId) {
      return isAuthed()
        && 'stakes' in request.auth.token
        && stakeId in request.auth.token.stakes
        && 'limited' in request.auth.token.stakes[stakeId]
        && request.auth.token.stakes[stakeId].limited == true;
    }

    // Returns the ward_code list for which the user has bishopric
    // visibility under `stakeId`. Empty list if not a member of that
    // stake.
    function bishopricWardOf(stakeId) {
      return isAuthed()
        && 'stakes' in request.auth.token
        && stakeId in request.auth.token.stakes
          ? request.auth.token.stakes[stakeId].wards
          : [];
    }

    // Any member of the stake — manager OR stake-scope member OR any
    // bishopric-ward member. Used to gate parent-stake-doc reads and
    // wards/buildings reads.
    function isAnyMember(stakeId) {
      return isManager(stakeId)
        || isStakeMember(stakeId)
        || bishopricWardOf(stakeId).size() > 0;
    }

    function isPlatformSuperadmin() {
      return isAuthed() && request.auth.token.isPlatformSuperadmin == true;
    }

    // Bootstrap-admin escape hatch — see file header. The token email
    // is the typed form (Firebase puts the verified-email string on
    // `request.auth.token.email`); we compare against the typed email
    // recorded on the stake doc by the operator's pre-seed. The
    // `setup_complete == false` clause makes this strictly time-bounded
    // so the moment the wizard flips that flag, this gate stops applying.
    //
    // The `get()` short-circuits if the stake doc doesn't exist (rule
    // returns false rather than erroring) — operator seed is mandatory
    // before the bootstrap admin signs in.
    function isBootstrapAdmin(stakeId) {
      let stakePath = /databases/$(database)/documents/stakes/$(stakeId);
      return isAuthed()
        && exists(stakePath)
        && get(stakePath).data.setup_complete == false
        && get(stakePath).data.bootstrap_admin_email == request.auth.token.email;
    }

    // Setup-in-progress escape hatch — required by the SPA's
    // setup-complete gate (per `docs/spec.md` §10): when `setup_complete == false`, any
    // authed user must be able to read the parent stake doc so the
    // gate can route them to SetupInProgress (instead of NotAuthorized
    // or a blank screen). Once the wizard flips `setup_complete` to
    // true, this gate goes silent and the standard `isAnyMember` rule
    // takes over.
    //
    // The disclosure surface is small: the parent stake doc carries
    // `stake_name`, `bootstrap_admin_email` (already the operator's
    // typed email), config knobs (`timezone`, `stake_seat_cap`), and
    // bookkeeping fields. None of these are
    // sensitive — `bootstrap_admin_email` is what the SetupInProgress
    // page renders to the non-admin so they know who to contact.
    function isSetupInProgressReadable(stakeId) {
      let stakePath = /databases/$(database)/documents/stakes/$(stakeId);
      return isAuthed()
        && exists(stakePath)
        && get(stakePath).data.setup_complete == false;
    }

    // The `lastActor` integrity check — every client write must
    // declare `lastActor.{email, canonical}` matching the auth token.
    // Server-side (Admin SDK) writes use synthetic actors
    // (`'RemoveTrigger'`, `'OutOfBand'`, `'Migration'`,
    // `'SyncActor:<code>'`) and bypass this check by bypassing rules
    // entirely.
    function lastActorMatchesAuth(data) {
      return data.lastActor.canonical == authedCanonical()
        && data.lastActor.email == request.auth.token.email;
    }

    // Extension v2.1 — shape check for `stake.kindoo_config`. Field is
    // optional; absence is fine. When present, must carry `site_id`
    // (number), `site_name` (string), `configured_at` (timestamp), and
    // `configured_by.{email, canonical}` (the ActorRef of the manager
    // who ran the config wizard). The check is structural — value
    // semantics (e.g. site_id matching Kindoo's actual EID) are
    // verified client-side before the write lands.
    function validKindooConfig(data) {
      return !('kindoo_config' in data)
        || (
             data.kindoo_config.site_id is int
          && data.kindoo_config.site_name is string
          && 'configured_at' in data.kindoo_config
          && data.kindoo_config.configured_by.email is string
          && data.kindoo_config.configured_by.canonical is string
        );
    }

    // Extension v2.1 — shape check for `building.kindoo_rule`. Same
    // pattern: optional; when present must carry `rule_id` (number) +
    // `rule_name` (string), the `{RID, Name}` pair captured from the
    // Kindoo admin UI's existing rule list.
    function validKindooRule(data) {
      return !('kindoo_rule' in data)
        || (
             data.kindoo_rule.rule_id is int
          && data.kindoo_rule.rule_name is string
        );
    }

    // Extension v2.2 — shape check for `kindoo_uid` + `provisioning_note`
    // on a request doc. Both fields optional; when present each must
    // be a string. `provisioning_note` is bounded (≤500 chars) so a
    // runaway extension client cannot bloat the request doc.
    function validKindooProvisioning(data) {
      return (!('kindoo_uid' in data) || data.kindoo_uid is string)
        && (!('provisioning_note' in data)
            || (data.provisioning_note is string
                && data.provisioning_note.size() <= 500));
    }

    // ===== Top-level collections =====

    // userIndex/{canonical} — written by `onAuthUserCreate` (Admin
    // SDK bypass); read by the user themselves so the SPA can confirm
    // the bridge entry exists with the expected uid.
    //
    // Self-update is permitted ONLY for `fcmTokens` + `notificationPrefs`
    // + `lastActor` (push-subscribe write surface). Create/delete remain
    // server-only. The `lastActor` integrity check stamps the writer so
    // any audit-trail tooling sees who toggled push state.
    match /userIndex/{memberCanonical} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow update: if isAuthed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmTokens', 'notificationPrefs', 'lastActor'])
        && lastActorMatchesAuth(request.resource.data);
      allow create, delete: if false;
    }

    // platformSuperadmins — allow-list for the cross-stake superadmin
    // role. Read by superadmins (so a superadmin can list peers);
    // write forbidden (managed via Firestore console only — see
    // `firebase-schema.md` §3.2).
    match /platformSuperadmins/{canonicalEmail} {
      allow read: if isPlatformSuperadmin();
      allow write: if false;
    }

    // platformAuditLog — cross-stake audit trail for stake creation
    // and superadmin-membership changes. Read by superadmins; writes
    // server-only (the `createStake` callable + the superadmin
    // sync triggers fan rows here via Admin SDK).
    match /platformAuditLog/{auditId} {
      allow read: if isPlatformSuperadmin();
      allow write: if false;
    }

    // ----- RemoteApply (phone → desktop-extension mailbox) -----
    // A Kindoo Manager taps a pending request on their phone; their own
    // desktop Chrome extension executes it against Kindoo. The transport
    // is this per-manager mailbox. See `docs/architecture.md` D27 and the
    // shared contract in `packages/shared/src/types/remoteApply.ts`.
    //
    //   `remoteApply/{canonical}`                   — the opt-in alone
    //   `remoteApply/{canonical}/desktops/{siteId}` — one live Kindoo tab
    //   `remoteApply/{canonical}/jobs/{jobId}`      — one tap
    //
    // Top-level rather than per-stake because the doc key is the
    // manager's canonical email and the desktop resolves its own stake
    // from whichever Kindoo site it happens to be in — the stake is a
    // FIELD here, not a path segment. Every surface is therefore anchored
    // on `authedCanonical()`: a manager can only ever touch their own
    // mailbox, which makes the rest of this block about shape and
    // lifecycle rather than about who.
    //
    // **Presence is keyed by Kindoo site.** A stake can run more than one
    // Kindoo site and a tab can only provision for the site it is inside,
    // so liveness lives in `desktops/{siteId}` — two tabs write two docs
    // instead of overwriting one another's EID every heartbeat, and a job
    // naming a site is claimed by the tab that can actually serve it
    // rather than by whichever tab polled first.
    //
    // `isManager(<the doc's stake_id>)` is the second gate on the
    // `desktops` and `jobs` writes. It is claims-only (no document read)
    // and it is what makes the mailbox useless to a non-manager.
    match /remoteApply/{memberCanonical} {

      // The doc key IS the owner's canonical email, so one comparison
      // against the `canonical` claim covers read, create, and update on
      // both the presence doc and its jobs.
      function ownsMailbox(owner) {
        return isAuthed() && authedCanonical() == owner;
      }

      // Exact-set match on a document's keys. Rules' List API has
      // `hasAll` / `hasOnly` but no `hasExactly`; the conjunction is it.
      function keysAreExactly(data, fields) {
        return data.keys().hasOnly(fields) && data.keys().hasAll(fields);
      }

      // `RemoteApplyPresence` shape check — three keys, and only three.
      // Everything per-site moved down to `desktops/{siteId}`.
      //
      // `remote_apply_enabled` is the only optional key: absent means
      // opted OUT (per the type's doc comment — a doc predating the
      // toggle must not read as consent), so the phone treats absence
      // and `false` identically and the rule needs only to type it when
      // present.
      //
      // NOTE for the extension: `hasOnly` means a `setDoc(..., {merge:
      // true})` over a doc still carrying the retired per-site keys is
      // DENIED, because the merged result is what rules see. The
      // heartbeat must write this doc whole.
      function validPresence(data) {
        return data.keys().hasOnly(['remote_apply_enabled', 'ext_version', 'lastActor'])
          && data.keys().hasAll(['ext_version', 'lastActor'])
          && (!('remote_apply_enabled' in data) || data.remote_apply_enabled is bool)
          && data.ext_version is string
          // Length bound, not a format check — see the `allow create,
          // update` comment below for why this doc needs one.
          && data.ext_version.size() <= 32;
      }

      allow read: if ownsMailbox(memberCanonical);
      // Create and update are the same predicate — the extension writes
      // the whole doc on every heartbeat, so there is no narrower update
      // surface to describe.
      //
      // NO `isManager` gate here, unlike `desktops` and `jobs` below.
      // This doc used to carry `stake_id` and the gate read it; the
      // field moved to `desktops`, and the alternatives for re-anchoring
      // it are all worse. Rules can't ask "is this user a manager of ANY
      // stake" (the `stakes` claim is a map and there is no way to test
      // a predicate across its values), and keeping a `stake_id` here
      // purely as a gate anchor would reintroduce exactly the field that
      // flapped between sites on every heartbeat.
      //
      // Dropping it is safe because the doc grants nothing on its own.
      // It is one bool, one version string and a `lastActor`; the phone
      // requires a fresh `desktops` doc before it offers the button, and
      // both `desktops` and `jobs` still carry `stake_id` and still gate
      // on it. A non-manager who writes here has published consent to
      // use a desktop they cannot register for a stake they cannot
      // queue work under.
      //
      // What the gate was really guarding — free storage under any
      // signed-in user's own canonical email — is instead bounded by the
      // exact three-key shape plus the `ext_version` length cap, which
      // caps the doc at a couple of hundred bytes. One such doc per
      // Google account that has signed into this app is not a storage
      // surface worth a per-heartbeat document read to close.
      allow create, update: if ownsMailbox(memberCanonical)
        && validPresence(request.resource.data)
        && lastActorMatchesAuth(request.resource.data);
      // Turning the feature off clears `remote_apply_enabled` rather
      // than deleting the doc, so the phone can distinguish "opted out"
      // from "never installed the extension". (Contrast `desktops`
      // below, where deletion is the correct opt-out signal.)
      allow delete: if false;

      // ----- desktops/{siteKey} — one live Kindoo tab, one Kindoo site -----
      //
      // Doc id is the tab's site KEY (`remoteApplySiteKey`), so two tabs
      // on two sites write two docs and neither clobbers the other. It
      // is the same value a job carries as `target_site_key`, which is
      // what makes the routing an exact match rather than a fallback.
      //
      // The id is NOT constrained here. Proving it names a real
      // `kindooSites` doc would cost a document read on every heartbeat,
      // and the home site has no such doc at all (home lives on
      // `stake.kindoo_config`), so home necessarily publishes under the
      // reserved `'home'` key. An id naming nothing is inert anyway — no
      // job targets it, so no work is ever routed to it.
      //
      // `kindoo_site_id` in the BODY is the underlying nullable form
      // (null = home), mirroring how wards and buildings spell it. Both
      // are stored because the doc id can't be null and the phone wants
      // the nullable value back without re-deriving it.
      //
      // `stake_id` keeps the `isManager` gate that the parent doc lost.
      // This is the doc that makes the phone's button appear, so it is
      // the one that has to prove the writer manages the stake it claims
      // to cover.
      match /desktops/{siteKey} {

        // `RemoteApplyDesktop` — every key required, three of them
        // nullable. `kindoo_eid` / `kindoo_site_name` go null when the
        // tab is inside a site it can't fully resolve; the phone renders
        // that as online-but-unnamed rather than hiding the desktop.
        //
        // The rule does NOT check `kindoo_site_id` against `siteKey`.
        // The two are related by `remoteApplySiteKey` (null ↔ 'home'),
        // which rules can't express without hardcoding the home key
        // here and pinning a shared constant in two places. The pairing
        // is the extension's to get right; a mismatched pair misroutes
        // only this manager's own jobs.
        function validDesktop(data) {
          return keysAreExactly(data, ['stake_id', 'kindoo_site_id', 'last_seen_at',
                                       'kindoo_eid', 'kindoo_site_name', 'ext_version',
                                       'lastActor'])
            && data.stake_id is string
            && (data.kindoo_site_id == null || data.kindoo_site_id is string)
            && data.last_seen_at is timestamp
            && (data.kindoo_eid == null || data.kindoo_eid is int)
            && (data.kindoo_site_name == null || data.kindoo_site_name is string)
            && data.ext_version is string;
        }

        allow read: if ownsMailbox(memberCanonical);

        // Create and update share a predicate for the same reason the
        // parent doc's do: a heartbeat rewrites the whole doc, and the
        // first one on a new site has to create it. Two tabs on two
        // sites therefore BOTH succeed — that is the entire point of
        // keying by site rather than by manager.
        allow create, update: if ownsMailbox(memberCanonical)
          && isManager(request.resource.data.stake_id)
          && validDesktop(request.resource.data)
          && lastActorMatchesAuth(request.resource.data);

        // Deletion allowed, gated on ownership alone.
        //
        // Aging out is the fallback, not the goal: a tab that closes or
        // navigates off its Kindoo site leaves a doc that stays "fresh"
        // for `REMOTE_APPLY_STALE_MS`, and during that window the phone
        // names a site as covered when it isn't. That is precisely the
        // "open a site you already have open" failure this reshape
        // exists to remove, so the extension is allowed to retract its
        // own presence immediately.
        //
        // Nothing is lost: unlike `jobs`, a desktop doc is liveness, not
        // history. And unlike the parent doc, absence is not an
        // ambiguous signal — the reader already treats absent and stale
        // identically.
        //
        // Deliberately NOT gated on `isManager`. A manager whose claim
        // has just been revoked must still be able to retract presence
        // they published while they held it; denying that would strand a
        // doc that only its owner can address.
        allow delete: if ownsMailbox(memberCanonical);
      }

      match /jobs/{jobId} {

        // `request_id` / `stake_id` / `target_site_key` / `created_at` /
        // `created_by_device` are set once by the phone and never move.
        // The per-transition `affectedKeys()` allowlists below already
        // exclude them; this states the invariant directly so it
        // survives an allowlist edit, mirroring the `access` block's
        // belt-and-braces treatment of `importer_callings`.
        //
        // `target_site_key` matters most of the five: it is what decides
        // WHICH desktop may claim the job, so a mutable one would let a
        // tab retarget work to itself and run a provision on the wrong
        // Kindoo site. A bare field read is safe here precisely because
        // the create rule makes it required — there is no job without
        // one to trip over.
        function jobCoreUnchanged(before, after) {
          return after.request_id == before.request_id
            && after.stake_id == before.stake_id
            && after.target_site_key == before.target_site_key
            && after.created_at == before.created_at
            && after.created_by_device == before.created_by_device;
        }

        // Shape check for a terminal write. `finished_at` and `outcome`
        // are typed when present but NOT required: a denial here would
        // strand the job in `running` and leave the phone spinning
        // forever, which is a worse failure than a terminal row missing
        // its timestamp. `outcome.code` is checked as a string, not
        // against the `RemoteApplyOutcomeCode` union — the union is the
        // desktop's vocabulary and should be extensible without a rules
        // deploy.
        function validFinish(data) {
          return (!('finished_at' in data) || data.finished_at is timestamp)
            && (!('outcome' in data)
                || (data.outcome.keys()
                      .hasOnly(['code', 'message', 'kindoo_uid', 'provisioning_note'])
                    && data.outcome.code is string
                    && data.outcome.message is string));
        }

        allow read: if ownsMailbox(memberCanonical);

        // A job is born `queued` and carries exactly the seven fields the
        // phone knows at tap time — no pre-baked `claimed_*` /
        // `finished_at` / `outcome`, which the transitions below are the
        // only path to.
        //
        // `target_site_key` is REQUIRED and never null. It is a site key
        // (`remoteApplySiteKey`), not a raw `kindooSites` doc id: the
        // home site has no such doc, so home is spelled with the
        // reserved `'home'` key and matches a desktop exactly the way a
        // foreign slug does. There is deliberately no "any site" value —
        // a phone that can't resolve the target site must not offer the
        // button, because it cannot know which desktop could serve it.
        //
        // Empty string is rejected for the same reason a null would be:
        // it names a site no tab can be inside, so the job would sit
        // unclaimable until the phone timed it out.
        //
        // IF YOU ARE WRITING A CLOUD FUNCTION THAT QUEUES JOBS: stamp
        // `target_site_key` yourself. Admin SDK writes bypass this rule,
        // and a job without the key is not merely malformed — it is
        // permanently stuck. The immutability check below reads the
        // field bare, a bare read of a missing key errors, and so every
        // transition is denied: it cannot be claimed, cannot be
        // cancelled by the phone's timeout, and cannot be reported
        // terminal. Nothing but admin credentials can clear it, since
        // `allow delete: if false`. Today every writer of this
        // collection is a client gated by this rule, which is the only
        // reason that state is unreachable.
        //
        // Derive the value with `resolveWardSite` + `remoteApplySiteKey`
        // from `packages/shared`; do not hand-roll the building lookup.
        // `resolveWardBuilding` falls through to a name match when the
        // ward's `building_id` misses, so a bare find-by-slug resolves a
        // stale-slug ward to home and the job is then refused by the very
        // tab it was routed to. See T-79.
        allow create: if ownsMailbox(memberCanonical)
          && isManager(request.resource.data.stake_id)
          && request.resource.data.status == 'queued'
          && keysAreExactly(request.resource.data,
                            ['request_id', 'stake_id', 'target_site_key', 'status',
                             'created_at', 'created_by_device', 'lastActor'])
          && request.resource.data.request_id is string
          && request.resource.data.request_id.size() > 0
          && request.resource.data.stake_id is string
          && request.resource.data.target_site_key is string
          && request.resource.data.target_site_key.size() > 0
          && request.resource.data.created_at is timestamp
          && request.resource.data.created_by_device is string
          && lastActorMatchesAuth(request.resource.data);

        // The status transitions ARE the lock. There is no transaction
        // available on the consuming side — the extension's MV3 service
        // worker can't run `runTransaction` — so the compare-and-set
        // lives here instead, the same technique the request reject /
        // complete rules use.
        //
        // Each branch pins the BEFORE status via `resource.data.status`.
        // That is what resolves the two-tab race: both open Kindoo tabs
        // poll, both see `queued`, both fire the claim; the first write
        // commits and the second now finds `running` where its branch
        // required `queued`, so rules reject it and that tab skips the
        // job. No branch admits a terminal before-status, so a finished
        // job is frozen.
        allow update: if ownsMailbox(memberCanonical)
          && lastActorMatchesAuth(request.resource.data)
          && jobCoreUnchanged(resource.data, request.resource.data)
          && (
            // queued → running — a Kindoo tab claiming the job.
            (resource.data.status == 'queued'
             && request.resource.data.status == 'running'
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'claimed_at', 'claimed_by', 'lastActor'])
             && (!('claimed_at' in request.resource.data)
                 || request.resource.data.claimed_at is timestamp)
             && (!('claimed_by' in request.resource.data)
                 || request.resource.data.claimed_by.ext_version is string))
            ||
            // queued → cancelled — the phone's no-pickup timeout.
            (resource.data.status == 'queued'
             && request.resource.data.status == 'cancelled'
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'finished_at', 'outcome', 'lastActor'])
             && validFinish(request.resource.data))
            ||
            // running → terminal — the extension reporting back.
            // `partial` is a distinct outcome, not a failure: Kindoo
            // took the write and `markRequestComplete` did not.
            (resource.data.status == 'running'
             && request.resource.data.status in ['applied', 'partial', 'failed']
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'finished_at', 'outcome', 'lastActor'])
             && validFinish(request.resource.data))
          );

        // Jobs are history — at 1–2 requests/week the collection stays
        // trivially small and the trail is useful when a provision
        // misbehaves.
        allow delete: if false;
      }
    }

    // ===== Per-stake collections =====

    match /stakes/{stakeId} {

      // Parent stake doc — Config-tab-equivalent fields. Read by any
      // member of the stake (the SPA's bootstrap response includes
      // stake metadata for every signed-in member). Updates by
      // managers only, enforcing the lastActor integrity check. Create
      // is superadmin-only via the `createStake` callable; delete
      // forbidden everywhere.
      //
      // Bootstrap-admin gate: while `setup_complete == false`, the
      // designated bootstrap admin can read the stake doc (the wizard
      // needs to render current values) and update it (Step 1 fields
      // and the final `setup_complete=true` flip). The flip itself
      // works because `isBootstrapAdmin` evaluates the pre-write state
      // — `setup_complete` is still false when the rule runs.
      //
      // Setup-in-progress read gate: while `setup_complete == false`,
      // ANY authed user can read the parent stake doc so the SPA's
      // setup-complete gate can route them to SetupInProgress. This is
      // a narrow read-only loosening tied to the same time-bound
      // condition as `isBootstrapAdmin`; once setup completes, the
      // standard `isAnyMember` rule takes over again.
      //
      // Platform-superadmin read gate (Phase 12.2): a superadmin must
      // be able to read every stake's parent doc to render the Stake
      // List page at `/superadmin/stakes`. This covers the zero-role
      // first-run state where the operator has just been seeded as a
      // superadmin but holds no manager / stake / bishopric role on any
      // stake — without this branch the page would render empty. The
      // superadmin claim already gates `platformSuperadmins` and
      // `platformAuditLog` reads; adding it here extends the same
      // surface to the per-stake parent docs only (no subcollection
      // widening — those stay member-gated).
      allow read: if isAnyMember(stakeId) || isBootstrapAdmin(stakeId)
        || isSetupInProgressReadable(stakeId)
        || isPlatformSuperadmin();
      allow create: if isPlatformSuperadmin();
      // `kindoo_config` (extension v2.1) is manager-writable as part of
      // the standard stake update path. Validation enforces the field
      // shape when present; absence is fine. Bootstrap admin path
      // pre-dates the extension and never writes this field, but the
      // validator is no-op when absent so it stays in the predicate.
      allow update: if (isManager(stakeId) || isBootstrapAdmin(stakeId))
        && lastActorMatchesAuth(request.resource.data)
        && validKindooConfig(request.resource.data);
      allow delete: if false;

      // ----- Wards -----
      // Any member of the stake can read the ward list (Roster UI
      // needs them for utilization rendering). Only managers can
      // mutate; the integrity check stamps the writing manager.
      // Bootstrap admin can read + write while `setup_complete=false`
      // so the wizard's Step 3 (≥1 ward) can land before the manager
      // claim is minted.
      //
      // Create + update carry the `lastActorMatchesAuth` integrity
      // check; delete cannot (no `request.resource.data` on delete) and
      // is gated only by the role predicate. Same split applied to
      // buildings + kindooManagers below.
      match /wards/{wardCode} {
        allow read: if isAnyMember(stakeId) || isBootstrapAdmin(stakeId);
        allow create, update: if (isManager(stakeId) || isBootstrapAdmin(stakeId))
          && lastActorMatchesAuth(request.resource.data);
        allow delete: if isManager(stakeId) || isBootstrapAdmin(stakeId);
      }

      // ----- Buildings -----
      // Same shape as wards — any member can read; only managers
      // can mutate. Bootstrap-admin gate matches wards: the wizard's
      // Step 2 (≥1 building) writes here.
      match /buildings/{buildingId} {
        allow read: if isAnyMember(stakeId) || isBootstrapAdmin(stakeId);
        // `kindoo_rule` (extension v2.1) is manager-writable as part of
        // the standard building update path. Validation enforces the
        // field shape when present; absence is fine.
        allow create, update: if (isManager(stakeId) || isBootstrapAdmin(stakeId))
          && lastActorMatchesAuth(request.resource.data)
          && validKindooRule(request.resource.data);
        allow delete: if isManager(stakeId) || isBootstrapAdmin(stakeId);
      }

      // ----- KindooSites -----
      // Multi-site Kindoo management — see `firebase-schema.md`. A
      // doc here represents a FOREIGN Kindoo site this stake's
      // kindooManagers can write to (e.g. a building physically
      // governed by another stake's Kindoo environment). The HOME site
      // lives on the parent stake doc (no `KindooSite` record); `null`
      // / missing `kindoo_site_id` on a BUILDING means home. Wards no
      // longer carry `kindoo_site_id` — a ward's site derives from its
      // assigned building.
      //
      // Read: any stake member (the SPA's bootstrap response surfaces
      // the site map alongside wards / buildings). Write: managers
      // only — same gating as `kindooManagers` because authority over
      // WHICH Kindoo environments this stake can target is a
      // stake-level configuration concern, not a ward-level one.
      // Existing csnorth `kindooManagers` allow-list governs all Kindoo
      // writes regardless of which site they target; this rule does not
      // introduce a new role.
      //
      // Field-level referential integrity (does the `kindoo_site_id` a
      // building references actually exist? do buildings still point at
      // a site being deleted? — wards are covered transitively
      // via their building) is the UI's concern; rules gate WHO can
      // write, not field-level FK checks.
      match /kindooSites/{kindooSiteId} {
        allow read: if isAnyMember(stakeId);
        allow create, update: if isManager(stakeId)
          && lastActorMatchesAuth(request.resource.data);
        allow delete: if isManager(stakeId);
      }

      // ----- Organizations -----
      // A stake-scope concept: a named seat pool with its own (display-
      // only) seat cap, managed by stake managers. Seats and requests
      // reference an organization by its immutable slug id
      // (`organization_id` = doc.id), meaningful only on stake-scope
      // grants. Mirrors `kindooSites`'s gating: any member reads (the
      // SPA's bootstrap response surfaces the org list for the
      // No-Organization picker), managers write with the `lastActor`
      // integrity check. Small unfiltered collection — no index needed.
      match /organizations/{organizationId} {
        allow read: if isAnyMember(stakeId);
        allow create, update: if isManager(stakeId)
          && lastActorMatchesAuth(request.resource.data);
        allow delete: if isManager(stakeId);
      }

      // ----- KindooManagers -----
      // Manager allow-list. Manager-only read so non-managers can't
      // enumerate peers; manager-only write. The bootstrap-admin gate
      // unblocks the chicken-and-egg: the wizard's first action is
      // adding the bootstrap admin to this collection, which fires
      // `syncManagersClaims` and mints the manager claim. Without the
      // gate, that very first write would be denied because the
      // bootstrap admin doesn't yet hold a manager claim.
      match /kindooManagers/{memberCanonical} {
        allow read: if isManager(stakeId) || isBootstrapAdmin(stakeId);
        allow create, update: if (isManager(stakeId) || isBootstrapAdmin(stakeId))
          && lastActorMatchesAuth(request.resource.data);
        allow delete: if isManager(stakeId) || isBootstrapAdmin(stakeId);
      }

      // ----- Access (split-ownership) -----
      // The most subtle rule block in this file. The doc has two
      // top-level maps with different write authorities:
      //
      //   - `importer_callings` — server-only (the weekly Importer
      //     wholesale-replaces this map per scope via Admin SDK).
      //     Rules forbid client mutation by requiring it to be
      //     byte-equal to the prior value on every client update.
      //
      //   - `importer_limited_callings` — server-only, same treatment.
      //     It is the D26 access-tier stamp on `importer_callings`
      //     (the subset of each scope's callings that confer D25's
      //     LIMITED tier), written by the same server writers in the
      //     same update. A client that could set it could grant itself full
      //     access by clearing the stamp, so it is gated exactly like
      //     the map it describes: absent on create, byte-equal on
      //     update, and NOT in the affectedKeys() allowlist. Absent
      //     means every importer calling is full, which is what every
      //     record predating the field says — hence `.get(…, {})`
      //     rather than a bare field read on both sides.
      //
      //   - `manual_grants` — manager-only client-writable. The
      //     `affectedKeys()` allowlist below enumerates exactly the
      //     fields a manager update may touch.
      //
      // Manager-only read covers `access` because non-managers
      // shouldn't be able to enumerate the role grants.
      match /access/{memberCanonical} {
        allow read: if isManager(stakeId);

        // Manager creates a manual-only access doc — no importer
        // rows yet (the importer would have created the doc itself
        // if there were any), so no tier stamp either. At least one
        // manual_grants entry is required so we don't create empty
        // docs that would immediately satisfy the delete predicate.
        allow create: if isManager(stakeId)
          && memberCanonical == request.resource.data.member_canonical
          && request.resource.data.importer_callings == {}
          && !('importer_limited_callings' in request.resource.data)
          && request.resource.data.manual_grants.size() > 0
          && lastActorMatchesAuth(request.resource.data);

        // Manager edits manual_grants only — `importer_callings` and
        // its tier stamp are immutable from clients, and only the
        // manual side + bookkeeping fields are in the affected-keys
        // allowlist.
        allow update: if isManager(stakeId)
          && request.resource.data.member_canonical == resource.data.member_canonical
          && request.resource.data.importer_callings == resource.data.importer_callings
          && request.resource.data.get('importer_limited_callings', {})
             == resource.data.get('importer_limited_callings', {})
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['manual_grants', 'last_modified_by', 'last_modified_at', 'lastActor'])
          && lastActorMatchesAuth(request.resource.data);

        // Manager deletes a now-empty access doc. The Importer
        // empties `importer_callings` on a wholesale-replace if the
        // user no longer has any qualifying callings; the manager
        // empties `manual_grants` by removing its last entry.
        // The delete only fires when both are empty so the doc-
        // existence invariant ("exists iff some grant exists") is
        // preserved. `importer_limited_callings` is deliberately NOT
        // consulted: it stamps grants, it is not one, so a stale stamp
        // must never keep an otherwise-empty doc alive.
        allow delete: if isManager(stakeId)
          && resource.data.importer_callings == {}
          && resource.data.manual_grants == {};
      }

      // ----- Seats -----
      // Reads: managers see all; stake members see every roster in
      // the stake (stake-level access grants cross-ward oversight —
      // the Ward Rosters page lists every ward, and a stake user
      // clicking any of them must succeed); bishopric members see
      // seats whose scope is one of their assigned wards.
      //
      // Creates: only via request completion (the
      // `tiedToRequestCompletion` cross-doc invariant below verifies
      // a request flips pending → complete in the same write). Auto
      // seats are written by the Importer via Admin SDK and bypass
      // rules entirely; client-create only allows manual/temp.
      //
      // Updates: denied for clients. Seats are mutated server-side only
      // via the Admin SDK (request-completion / removal / import-sync),
      // which bypasses rules. Editing a seat is request-only.
      //
      // Deletes: managers can delete a manual/temp seat with no
      // duplicate_grants. Remove-request completions go through a
      // Cloud Function (Admin SDK bypass) instead, since client
      // delete rules can't read request.resource.data.
      match /seats/{memberCanonical} {
        // T-43 Phase B: bishopric reads widen to cover seats whose
        // any-grant scope matches the bishopric's ward(s). The
        // `duplicate_scopes` primitive-array mirror (server-maintained
        // — see Seat doc comment) is what we read here because CEL
        // can't project `[*].field` across an array of objects. The
        // `'duplicate_scopes' in resource.data` presence guard is
        // defense-in-depth: if any seat-write path lands a doc without
        // the field, `hasAny(...)` on an absent field throws and the
        // bishopric read explodes; the presence check degrades that
        // case to "no duplicate matches" rather than a hard rule error.
        // Stake-presidency reads need no widening — `isStakeMember`
        // already grants unrestricted seat reads.
        allow read: if isManager(stakeId)
          || isStakeMember(stakeId)
          || (resource.data.scope in bishopricWardOf(stakeId))
          || ('duplicate_scopes' in resource.data
              && resource.data.duplicate_scopes.hasAny(bishopricWardOf(stakeId)));

        // T-42 / T-43: `duplicate_scopes` is a server-maintained
        // primitive mirror of `duplicate_grants[].scope` (Firestore CEL
        // can't project `[*].field`). Clients never write it directly.
        // The create rule below requires `duplicate_scopes.size() == 0`
        // (consistent with `duplicate_grants.size() == 0` for client-
        // initiated seat creates); the update rule's `hasOnly` allow-
        // list does NOT include `duplicate_scopes`, so attempts to
        // mutate it from the client are rejected. Server writes
        // (Importer, `markRequestComplete`, `removeSeatOnRequestComplete`,
        // migration) all use the Admin SDK, which bypasses rules.
        allow create: if isManager(stakeId)
          && memberCanonical == request.resource.data.member_canonical
          && request.resource.data.type in ['manual', 'temp']
          && request.resource.data.duplicate_grants.size() == 0
          && (!('duplicate_scopes' in request.resource.data)
              || request.resource.data.duplicate_scopes.size() == 0)
          && request.resource.data.callings.size() == 0
          && lastActorMatchesAuth(request.resource.data)
          && tiedToRequestCompletion(stakeId,
                                     request.resource.data.granted_by_request,
                                     request.resource.data.scope,
                                     memberCanonical,
                                     request.resource.data.type);

        // Updates: the ONLY client-writable seat mutation is the inline
        // organization edit — a stake member may set / clear
        // `organization_id` on a `scope == 'stake'` seat, bypassing the
        // request flow (organizations are a stake-scope concept). The
        // `affectedKeys().hasOnly([...])` allowlist matches the web
        // inline-edit mutation EXACTLY (those 4 keys, nothing else), so a
        // hand-crafted write can't smuggle other field changes through
        // this path. The value-type guards mirror the `requests` block's
        // `is string` / `is timestamp` rigor: `organization_id` is a
        // string or null (slug or cleared), `last_modified_at` resolves
        // to a timestamp (`serverTimestamp()` is the value the rule sees,
        // same as the requests block's `requested_at == request.time`),
        // and `last_modified_by` carries string `email` / `canonical`.
        // Every OTHER seat mutation stays server-side via the Admin SDK
        // (request-completion through `markRequestComplete`, removal
        // through `removeSeatOnRequestComplete`, import-sync callables),
        // all of which bypass rules. Editing any other seat field is
        // request-only — an `edit_*` request completed by the callable.
        allow update: if isStakeMember(stakeId)
          && resource.data.scope == 'stake'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['organization_id', 'last_modified_at', 'last_modified_by', 'lastActor'])
          && (request.resource.data.organization_id == null
              || request.resource.data.organization_id is string)
          && request.resource.data.last_modified_at is timestamp
          && request.resource.data.last_modified_by.email is string
          && request.resource.data.last_modified_by.canonical is string
          && lastActorMatchesAuth(request.resource.data);

        allow delete: if isManager(stakeId)
          && resource.data.type in ['manual', 'temp']
          && resource.data.duplicate_grants.size() == 0;
      }

      // The cross-doc invariant that gates seat creation: a manual /
      // temp seat may only be created when the request that justifies
      // it transitions from pending → complete in the same write. We
      // use `getAfter()` (the after-this-write view) to read the
      // request as it will look once the client's transaction commits.
      // `getAfter()` is used here and ONLY here — every other rule
      // is local to its own document.
      function tiedToRequestCompletion(sid, requestId, expectedScope, expectedMember, expectedSeatType) {
        let reqBefore = get(/databases/$(database)/documents/stakes/$(sid)/requests/$(requestId));
        let reqAfter  = getAfter(/databases/$(database)/documents/stakes/$(sid)/requests/$(requestId));
        return reqBefore.data.status == 'pending'
          && reqAfter.data.status == 'complete'
          && reqAfter.data.scope == expectedScope
          && reqAfter.data.member_canonical == expectedMember
          && (
            (expectedSeatType == 'manual' && reqAfter.data.type == 'add_manual')
            || (expectedSeatType == 'temp' && reqAfter.data.type == 'add_temp')
          );
      }

      // ----- Limited-app-access helpers (D25) -----
      // Only ever reached from the `requests` create predicate, and
      // only when `isLimited(stakeId)` is true — so full users pay
      // none of the cost below (no extra document reads).

      // Temp windows for a limited user are capped at 90 days
      // inclusive of both endpoints' dates. Safe to split / int() the
      // segments unguarded: this runs AFTER the create predicate's
      // ISO `^\d{4}-\d{2}-\d{2}$` shape check and its
      // `start_date <= end_date` check, both of which short-circuit
      // the whole `&&` chain before we get here. `int()` parses
      // leading-zero segments ('03', '05') correctly — verified
      // against the emulator and pinned by a regression test.
      function tempWindowWithin90Days(data) {
        let s = data.start_date.split('-');
        let e = data.end_date.split('-');
        return timestamp.date(int(e[0]), int(e[1]), int(e[2]))
             - timestamp.date(int(s[0]), int(s[1]), int(s[2]))
            <= duration.value(90, 'd');
      }

      // Resolve a ward's building name the same way the client does —
      // ID-FIRST with a raw-name fallback — mirroring
      // `resolveWardBuilding` in `packages/shared/src/resolveWardSite.ts`.
      //
      // `building_id` is the preferred FK (an immutable slug that IS the
      // building's doc ID). `building_name` is a legacy display-name
      // snapshot that is still required but CAN go stale:
      // `buildingRenameBlocker` only blocks a building rename while a
      // seat or pending request references the old name — it does not
      // check `wards`. So a ward with no seats can have its building
      // renamed out from under its `building_name`. Reading the ward's
      // `building_name` directly (the original form of this helper) then
      // demanded the STALE name while the client sent the CURRENT one,
      // locking limited users out of submitting at all.
      //
      // The ternary SHORT-CIRCUITS — verified against the emulator, and
      // pinned by the dangling-`building_id` test in
      // `tests/requests.test.ts`. The building `get()` is therefore not
      // evaluated when `exists()` is false, so a dangling slug falls
      // through to the name path instead of erroring the whole
      // predicate. `Map.get(key, default)` is used over a bare field
      // read for the same reason: an absent key yields '' (which the
      // caller's size check rejects) rather than an error.
      //
      // Document access cost: 1 ward `get()`, 1 building `exists()`, and
      // at most 1 building `get()` — 3 of the 10 allowed per
      // single-document request.
      function limitedWardBuildingName(sid, scope) {
        let ward = get(/databases/$(database)/documents/stakes/$(sid)/wards/$(scope)).data;
        let bid = ward.get('building_id', '');
        return bid is string
            && bid.size() > 0
            && exists(/databases/$(database)/documents/stakes/$(sid)/buildings/$(bid))
          ? get(/databases/$(database)/documents/stakes/$(sid)/buildings/$(bid)).data.get('building_name', '')
          : ward.get('building_name', '');
      }

      // A limited user's ward-scope temp request is locked to exactly
      // the ward's own building — no cross-building grants, no
      // multi-building supersets.
      //
      // Fails closed on every degenerate input: a missing ward doc makes
      // the `get()` in `limitedWardBuildingName` return null and the
      // field read errors out (rules errors deny); a ward with neither a
      // resolvable `building_id` nor a non-empty `building_name`
      // resolves to '' and fails the size guard.
      function limitedWardBuildingOk(sid, data) {
        let name = limitedWardBuildingName(sid, data.scope);
        return name is string && name.size() > 0 && data.building_names == [name];
      }

      // A limited user may only remove TEMP seats — auto and manual
      // seats are outside their authority. `get()` rather than
      // `exists()` for the same reason as above: we need the seat's
      // `type` VALUE.
      //
      // The `seat_member_canonical` guards come first so a request
      // omitting the field (or carrying an empty string, which would
      // build a malformed document path) denies on a legible
      // predicate instead of an opaque path-construction error. A
      // seat doc that simply doesn't exist still denies — `get()`
      // returns null and the field read errors.
      function limitedRemoveTargetIsTemp(sid, data) {
        return 'seat_member_canonical' in data
          && data.seat_member_canonical is string
          && data.seat_member_canonical.size() > 0
          && get(/databases/$(database)/documents/stakes/$(sid)/seats/$(data.seat_member_canonical)).data.type == 'temp';
      }

      // The edit-side mirror: a limited user may only edit TEMP seats.
      // Only `edit_temp` ever reaches here — `edit_auto` / `edit_manual`
      // are already off the limited type list — but without this the
      // create predicate accepted an off-UI `edit_temp` aimed at a
      // manual / auto seat, which `markRequestComplete` then rejected
      // at completion, leaving a dead row in the manager queue.
      //
      // Reads a DIFFERENT field than the remove gate: `edit_*` resolves
      // its seat as `seats/{member_canonical}` (see
      // `functions/src/callable/markRequestComplete.ts`), while `remove`
      // uses `seat_member_canonical`. Same defensive guards for the same
      // reason — an absent or empty field would build a collection path
      // and error opaquely rather than deny legibly. A seat doc that
      // simply doesn't exist still denies: `get()` returns null and the
      // field read errors.
      //
      // Same accepted edge as the remove gate: this checks the seat's
      // PRIMARY `type`, so a temp duplicate grant sitting under a
      // non-temp primary is denied for limited users. `canEditSeat` in
      // the client applies the identical primary-type test, so the UI
      // never offers a submit these rules reject.
      //
      // Document access cost: 1 seat `get()`. Worst case for the whole
      // limited path is a ward-scope `edit_temp` — this read on top of
      // `limitedWardBuildingName`'s 3 — so 4 of the 10 allowed per
      // single-document request. `add_temp` and `remove` short-circuit
      // this conjunct and pay nothing for it.
      function limitedEditTargetIsTemp(sid, data) {
        return 'member_canonical' in data
          && data.member_canonical is string
          && data.member_canonical.size() > 0
          && get(/databases/$(database)/documents/stakes/$(sid)/seats/$(data.member_canonical)).data.type == 'temp';
      }

      // ----- Requests -----
      // Reads: managers see all; the original requester sees their
      // own; stake-scope members see every request in the stake
      // (stake-level access grants cross-ward oversight — the Ward
      // Rosters page also surfaces pending requests per ward, and a
      // stake user clicking any ward must succeed); ward-scope is
      // visible to bishopric members of that ward.
      //
      // Creates (Submit): only `pending` is a legal starting status.
      // The requester_canonical must match the auth token's canonical
      // claim. Add-types and edit-types require member_name (only
      // `remove` may have an empty name); stake-scope add/edit-types
      // require at least one building selection. Scope must match
      // the requester's role:
      //   - Kindoo Manager: every scope, every type — no `access` row
      //     required
      //   - stake-scope: stake membership
      //   - ward-scope: that ward in the bishopric list
      // The self-approval invariant (spec §6, F12 invariant 7) still
      // works: a manager can submit then complete their own request.
      //
      // Edit types — `edit_auto`, `edit_manual`, `edit_temp` — flow
      // through the same submit / Mark Complete path as add / remove.
      // Same role-for-scope gating applies. Two extra constraints:
      //   - `edit_auto` is forbidden when `scope == 'stake'` (Policy 1).
      //     Stake auto seats are Church-granted to all stake buildings
      //     and have nothing editable. Three layers of defense for
      //     this: web UI hides the Edit button, this rule rejects the
      //     create, and `markRequestComplete` rejects the completion.
      //   - `edit_temp` requires the same `start_date` / `end_date`
      //     shape as `add_temp` (ISO YYYY-MM-DD; start <= end).
      //
      // Updates: pending → terminal only. Cancellation is requester-
      // only; complete / reject are manager-only. Reject requires a
      // non-empty rejection_reason.
      //
      // Deletes: never.
      match /requests/{requestId} {
        allow read: if isAuthed() && (
          isManager(stakeId)
          || resource.data.requester_canonical == authedCanonical()
          || isStakeMember(stakeId)
          || (resource.data.scope in bishopricWardOf(stakeId))
        );

        // `urgent` typed as bool when present (missing → treated as
        // false on read); rules forbid garbage like `urgent: 17` /
        // `urgent: "yes"`. Immutable post-submit: the update predicate
        // below uses an explicit field allowlist for each terminal
        // transition (cancel/complete/reject) and `urgent` is not in
        // any of those sets, so it cannot be modified.
        //
        // `add_temp` carries ISO `YYYY-MM-DD` start_date + end_date
        // with `start_date <= end_date`. The manager queue's
        // sectioning (Outstanding vs Future) depends on start_date
        // being present and well-formed for every add_temp.
        allow create: if isAuthed()
          && request.resource.data.status == 'pending'
          && request.resource.data.requester_canonical == authedCanonical()
          && request.resource.data.requested_at == request.time
          && lastActorMatchesAuth(request.resource.data)
          && (!('urgent' in request.resource.data)
              || request.resource.data.urgent is bool)
          && (request.resource.data.type == 'remove'
              || request.resource.data.member_name.size() > 0)
          // Every `add_*` / `edit_*` request must carry at least one
          // building regardless of scope (operator decision 2026-05-16,
          // ratified in spec §5.1 / §6). The web form schema gates
          // Submit on the same predicate; this is the rule-side defense.
          // `remove` is exempt — no building selection involved.
          && (request.resource.data.type == 'remove'
              || request.resource.data.building_names.size() > 0)
          && (request.resource.data.type != 'add_temp'
              && request.resource.data.type != 'edit_temp'
              || (
                   'start_date' in request.resource.data
                && 'end_date' in request.resource.data
                && request.resource.data.start_date is string
                && request.resource.data.end_date is string
                && request.resource.data.start_date.matches('^\\d{4}-\\d{2}-\\d{2}$')
                && request.resource.data.end_date.matches('^\\d{4}-\\d{2}-\\d{2}$')
                && request.resource.data.start_date <= request.resource.data.end_date
              ))
          // Policy 1 — edit_auto is forbidden on stake scope. Stake
          // auto seats have no editable surface (Church-granted access
          // to all stake buildings). Web UI hides the Edit button;
          // `markRequestComplete` also rejects this; the rule is the
          // third defense layer.
          && (request.resource.data.type != 'edit_auto'
              || request.resource.data.scope != 'stake')
          // Edit types require a non-empty `comment` so the manager
          // queue surfaces the operator's rationale. Rules check the
          // simpler "is a non-empty string" predicate; the shared
          // `accessRequestSchema` zod refinement at the SDK boundary
          // applies the stricter trim-then-check semantics. Add /
          // remove types are unaffected (any comment value or absence
          // is allowed here; web form layers the cross-ward-add
          // comment rule on top).
          && (
            (request.resource.data.type != 'edit_auto'
             && request.resource.data.type != 'edit_manual'
             && request.resource.data.type != 'edit_temp')
            || (
                 'comment' in request.resource.data
              && request.resource.data.comment is string
              && request.resource.data.comment.size() > 0
            )
          )
          // Role-for-scope gate (defense-in-depth complement to the
          // SPA's `allowedScopesFor` filter). Any one branch authorises:
          //   - Kindoo Manager → every scope (stake + any ward) and
          //     every type. Managers hold full request-creation
          //     authority and need no `access` row of their own.
          //   - `scope == 'stake'` → caller holds `stake: true`
          //   - `scope == <ward>`  → caller's `wards` includes that code
          // Stake members and bishopric members keep their own branches
          // unchanged. The manager branch widens WHO may create, never
          // WHAT the payload must carry — every other conjunct above
          // still applies, including Policy 1 (`edit_auto` forbidden at
          // `scope == 'stake'`), which binds managers too.
          //
          // `scope` is deliberately not checked against the ward list: a
          // manager could write an unknown ward code. That is a
          // data-quality gap for a trusted role, not an escalation.
          && (
               isManager(stakeId)
            || (request.resource.data.scope == 'stake' && isStakeMember(stakeId))
            || (request.resource.data.scope in bishopricWardOf(stakeId))
          )
          // Limited app access (D25). A user carrying
          // `stakes[stakeId].limited == true` gets a narrowed submit
          // surface; everyone else is untouched — a full user short-
          // circuits on `!isLimited(stakeId)` and never evaluates a
          // single clause below (nor pays for the `get()` reads the
          // ward / seat checks need). Managers are never limited —
          // the claim minter refuses to mint `limited` for an active
          // `kindooManagers` row — so the manager branch above keeps
          // its full reach.
          //
          // The narrowed surface, per D25:
          //   - type restricted to `add_temp` / `edit_temp` / `remove`
          //     (no manual grants, no auto edits);
          //   - temp windows capped at 90 days end-to-start;
          //   - ward-scope temp requests locked to exactly that ward's
          //     own building (stake scope keeps the free building
          //     choice — there is no single ward to lock to);
          //   - `remove` allowed only against a seat whose
          //     `type == 'temp'`, and `edit_temp` likewise — the same
          //     temp-only authority read through each type's own seat
          //     key (`seat_member_canonical` vs `member_canonical`).
          //
          // This is the LAST clause in the predicate on purpose: the
          // date-shape and role-for-scope gates above must have
          // already passed, so `start_date` / `end_date` are known to
          // be well-formed ISO strings by the time
          // `tempWindowWithin90Days` splits them.
          && (
            !isLimited(stakeId)
            || (
                 request.resource.data.type in ['add_temp', 'edit_temp', 'remove']
              && (request.resource.data.type != 'remove'
                  || limitedRemoveTargetIsTemp(stakeId, request.resource.data))
              && (request.resource.data.type != 'edit_temp'
                  || limitedEditTargetIsTemp(stakeId, request.resource.data))
              && (request.resource.data.type == 'remove'
                  || (
                       tempWindowWithin90Days(request.resource.data)
                    && (request.resource.data.scope == 'stake'
                        || limitedWardBuildingOk(stakeId, request.resource.data))
                  ))
            )
          );

        // `urgent` is requester-set on submit and immutable afterward.
        // Each transition's affectedKeys allowlist below excludes it,
        // and we additionally require the field's value (or absence)
        // be byte-equal across the write so a client cannot toggle it
        // even by smuggling it into an otherwise-allowed update.
        allow update: if resource.data.status == 'pending'
          && lastActorMatchesAuth(request.resource.data)
          && (('urgent' in resource.data) == ('urgent' in request.resource.data))
          && (!('urgent' in resource.data)
              || request.resource.data.urgent == resource.data.urgent)
          && (
            // Cancel — only the original requester
            (request.resource.data.status == 'cancelled'
             && resource.data.requester_canonical == authedCanonical()
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'lastActor']))
            ||
            // Complete — only managers (self-approval is allowed; rules
            // do not require requester != completer per F12 invariant 7).
            // Extension v2.2 — `kindoo_uid` + `provisioning_note` are
            // optional manager-writable fields on the complete transition
            // (the extension's Provision & Complete flow sets them; the
            // SPA mark-complete path leaves them absent). Shape-checked
            // by `validKindooProvisioning` to bound the disclosure surface.
            (request.resource.data.status == 'complete'
             && isManager(stakeId)
             && request.resource.data.completer_canonical == authedCanonical()
             && validKindooProvisioning(request.resource.data)
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'completer_email', 'completer_canonical',
                          'completed_at', 'completion_note', 'completion_status',
                          'kindoo_uid', 'provisioning_note', 'lastActor']))
            ||
            // Reject — only managers, with non-empty reason
            (request.resource.data.status == 'rejected'
             && isManager(stakeId)
             && request.resource.data.rejection_reason.size() > 0
             && request.resource.data.completer_canonical == authedCanonical()
             && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'completer_email', 'completer_canonical',
                          'completed_at', 'rejection_reason', 'lastActor']))
          );

        allow delete: if false;
      }

      // ----- AuditLog -----
      // Manager-only read (the manager Audit Log page surfaces this).
      // Writes server-only — the parameterized `auditTrigger` Cloud
      // Function fans rows here via Admin SDK.
      match /auditLog/{auditId} {
        allow read: if isManager(stakeId);
        allow write: if false;
      }
    }
  }
}
